# Required
COOKIE_SECRET=change-me-to-a-random-32-plus-character-string-before-production

# Server
PORT=3001
NODE_ENV=production
EXTERNAL_PORT=8080

# Storage paths (inside container — change only if using custom volume mounts)
DATABASE_PATH=/app/data/body-tracker.db
PHOTOS_PATH=/app/data/photos

# Docker image for production compose
# Normalized to lowercase as required by GHCR
GHCR_IMAGE=ghcr.io/dhruvcx-1/forma:latest
