# Required: 32+ character random secret for signing session cookies
COOKIE_SECRET=change-me-to-a-random-32-plus-character-string-before-production

# Server Settings
PORT=3001
NODE_ENV=production
EXTERNAL_PORT=3001

# Registration (default: true)
# When set to false, only administrators can manage accounts
ALLOW_REGISTRATION=true

# Storage paths inside container (mounted from volume or host directory)
DATABASE_PATH=/app/data/body-tracker.db
PHOTOS_PATH=/app/data/photos
# Set these values to your own host name and public origin when using Traefik.
FORMA_DOMAIN=forma.example.com
PUBLIC_URL=https://forma.example.com
FORMA_IMAGE=ghcr.io/dhruvcx-1/forma:latest
