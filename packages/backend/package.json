{
  "name": "@forma/backend",
  "version": "1.0.0",
  "description": "Body Progress Tracker - Backend API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "db:migrate": "tsx -e \"import('./src/db/index.ts')\"",
    "db:seed": "tsx src/scripts/seed-demo.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^10.1.11",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.2.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "nanoid": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
