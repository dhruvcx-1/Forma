# Database
DATABASE_PATH=./data/body-tracker.db

# File storage
PHOTOS_PATH=./data/photos

# Auth
# Must be at least 32 characters in production
COOKIE_SECRET=change-me-to-a-random-secret-at-least-32-chars

# Server
PORT=3001
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# Optional BYOK AI support. Generate a stable key with: openssl rand -base64 32
FORMA_AI_ENCRYPTION_KEY=
# Remote AI providers must use HTTPS.
FORMA_AI_ALLOW_HTTP_BASE_URL=false
