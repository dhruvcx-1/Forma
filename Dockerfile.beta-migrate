# Minimal, one-time schema bootstrap image for the isolated beta volume.
# It uses the existing TypeScript migrations unchanged. It only runs them when
# the beta database file does not exist; existing files are checked read-only.
FROM node:24-bookworm-slim AS runtime

WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/backend/package.json ./packages/backend/
RUN npm ci --workspace=@forma/backend --include=dev
COPY packages/backend/src/db ./packages/backend/src/db

RUN mkdir -p /app/data /app/.npm-cache \
    && chown -R 100:100 /app/data /app/.npm-cache

ENV HOME=/app \
    NPM_CONFIG_CACHE=/app/.npm-cache \
    DATABASE_PATH=/app/data/body-tracker.db
USER 100:100
CMD ["/bin/sh", "-ec", "if [ -e \"$DATABASE_PATH\" ]; then node -e 'const D=require(\"better-sqlite3\"); const db=new D(process.env.DATABASE_PATH,{readonly:true}); const v=db.pragma(\"user_version\",{simple:true}); db.close(); if(v<10){console.error(\"Beta database schema is older than version 10; refusing to migrate an existing database.\");process.exit(1)}'; else npm run db:migrate --workspace=@forma/backend; fi"]
