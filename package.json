{
  "name": "forma",
  "version": "1.0.0",
  "private": true,
  "description": "Premium self-hosted body progress tracker",
  "workspaces": [
    "packages/backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@forma/backend",
    "build": "npm run build --workspace=@forma/backend",
    "test": "npm run test --workspace=@forma/backend",
    "start": "npm run start --workspace=@forma/backend",
    "db:seed": "npm run db:seed --workspace=@forma/backend"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
